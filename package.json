{
  "name": "textlint-rule-preset-ai-words-ja",
  "version": "1.2.1",
  "description": "textlint preset that detects AI-flavored Japanese words and phrases",
  "keywords": [
    "textlintrule",
    "textlint",
    "japanese",
    "ai"
  ],
  "homepage": "https://github.com/p1ass/textlint-rule-preset-ai-words-ja",
  "bugs": {
    "url": "https://github.com/p1ass/textlint-rule-preset-ai-words-ja/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p1ass/textlint-rule-preset-ai-words-ja.git"
  },
  "license": "MIT",
  "author": "p1ass",
  "packageManager": "pnpm@10.8.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && textlint-scripts build",
    "prepublishOnly": "npm run build",
    "test": "textlint-scripts test",
    "watch": "textlint-scripts build --watch",
    "lint:text": "pnpm build && textlint \"**/*.md\"",
    "lint:text:fix": "pnpm build && textlint --fix \"**/*.md\"",
    "check:example": "node scripts/check-example.mts",
    "sync:example-version": "node scripts/sync-example-version.mts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "version": "node scripts/sync-example-version.mts && git add example/package.json"
  },
  "dependencies": {
    "kuromojin": "^3.0.1",
    "morpheme-match-textlint": "^2.0.6"
  },
  "devDependencies": {
    "@textlint/ast-node-types": "^15.8.0",
    "@textlint/types": "^15.8.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.4",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ai-words-ja": "link:.",
    "textlint-rule-preset-ja-spacing": "^3.0.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-scripts": "^15.8.0",
    "textlint-tester": "^15.8.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
